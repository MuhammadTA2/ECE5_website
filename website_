<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Project Gallery</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap');

  :root{
    --bg:#EEF1EA;
    --bg-grid:rgba(20,40,32,0.055);
    --ink:#152922;
    --ink-soft:#4B5B53;
    --pcb:#1B5E3E;
    --pcb-dark:#123F29;
    --copper:#B3702E;
    --copper-light:#E4C9A6;
    --led:#B23A2E;
    --card:#FCFDF8;
    --border:#CDD4C6;
    --border-strong:#A9B2A0;
    --radius:10px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:
      repeating-linear-gradient(0deg, var(--bg-grid) 0px, var(--bg-grid) 1px, transparent 1px, transparent 28px),
      repeating-linear-gradient(90deg, var(--bg-grid) 0px, var(--bg-grid) 1px, transparent 1px, transparent 28px),
      var(--bg);
    color:var(--ink);
    font-family:'IBM Plex Sans', system-ui, sans-serif;
    line-height:1.55;
    min-height:100vh;
  }
  ::selection{background:var(--copper-light);}

  .wrap{max-width:960px;margin:0 auto;padding:2.5rem 1.5rem 5rem;}

  /* ---------- Header / hero ---------- */
  .hero{position:relative;padding:1.5rem 0 2.25rem;border-bottom:1px solid var(--border);margin-bottom:2rem;overflow:hidden;}
  .trace-svg{position:absolute;top:-10px;right:-30px;width:260px;height:140px;opacity:0.55;pointer-events:none;}
  .status-bar{
    display:inline-flex;align-items:center;gap:8px;
    font-family:'IBM Plex Mono', monospace;font-size:12px;letter-spacing:.03em;
    color:var(--pcb-dark);background:var(--card);border:1px solid var(--border);
    padding:5px 12px;border-radius:99px;margin-bottom:1.1rem;
  }
  .status-dot{width:7px;height:7px;border-radius:50%;background:var(--pcb);flex:none;}
  @media (prefers-reduced-motion:no-preference){
    .status-dot{animation:pulse 2.2s ease-in-out infinite;}
  }
  @keyframes pulse{0%,100%{opacity:1;}50%{opacity:.35;}}

  .title-row{display:flex;align-items:flex-start;justify-content:space-between;gap:1.5rem;flex-wrap:wrap;}
  h1{
    font-family:'Space Grotesk', sans-serif;font-weight:600;
    font-size:clamp(28px,4.4vw,42px);margin:0 0 .35rem;letter-spacing:-.01em;color:var(--ink);
    max-width:640px;
  }
  .subtitle{color:var(--ink-soft);font-size:15px;margin:0;max-width:560px;}
  .editable-title[contenteditable="true"], .editable-sub[contenteditable="true"]{
    outline:2px dashed var(--copper);outline-offset:4px;border-radius:4px;background:var(--card);
  }

  .btn{
    font-family:'IBM Plex Sans', sans-serif;font-size:13.5px;font-weight:500;
    border:1px solid var(--border-strong);background:var(--card);color:var(--ink);
    padding:8px 14px;border-radius:8px;cursor:pointer;display:inline-flex;align-items:center;gap:6px;
    transition:transform .12s ease, background .12s ease;
  }
  .btn:hover{background:#fff;}
  .btn:active{transform:scale(0.97);}
  .btn-primary{background:var(--pcb);border-color:var(--pcb-dark);color:#fff;}
  .btn-primary:hover{background:var(--pcb-dark);}
  .btn-danger{border-color:var(--led);color:var(--led);}
  .btn-danger:hover{background:#FBEAE8;}
  .btn-quiet{border-color:transparent;background:transparent;padding:6px 8px;font-size:12.5px;color:var(--ink-soft);}
  .btn-quiet:hover{background:var(--card);}
  .btn[disabled]{opacity:.45;cursor:not-allowed;}

  .icon{width:15px;height:15px;flex:none;}

  /* ---------- toolbar ---------- */
  .toolbar{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:1.5rem;flex-wrap:wrap;}
  .count-readout{font-family:'IBM Plex Mono', monospace;font-size:12px;color:var(--ink-soft);}

  /* ---------- grid ---------- */
  .grid{display:grid;grid-template-columns:repeat(auto-fill, minmax(255px,1fr));gap:1.15rem;}
  .card{
    background:var(--card);border:1px solid var(--border);border-radius:12px;overflow:hidden;
    display:flex;flex-direction:column;position:relative;
    opacity:0;transform:translateY(10px);transition:opacity .5s ease, transform .5s ease;
  }
  .card.in-view{opacity:1;transform:translateY(0);}
  @media (prefers-reduced-motion:reduce){ .card{transition:none;opacity:1;transform:none;} }

  .card::before{
    content:"";position:absolute;top:0;left:16px;width:26px;height:6px;background:var(--copper);
    border-radius:0 0 3px 3px;opacity:.8;
  }
  .img-frame{width:100%;aspect-ratio:4/3;background:#E4E7DD;display:flex;align-items:center;justify-content:center;overflow:hidden;}
  .img-frame img{width:100%;height:100%;object-fit:cover;display:block;}
  .img-broken{font-family:'IBM Plex Mono', monospace;font-size:11.5px;color:var(--ink-soft);text-align:center;padding:1rem;}

  .card-body{padding:.85rem .95rem 1rem;display:flex;flex-direction:column;gap:.5rem;flex:1;}
  .caption{font-size:14px;color:var(--ink);margin:0;white-space:pre-wrap;word-break:break-word;}
  .caption.placeholder{color:var(--ink-soft);font-style:italic;}
  .caption-edit{
    width:100%;font-family:'IBM Plex Sans', sans-serif;font-size:14px;color:var(--ink);
    border:1px solid var(--border-strong);border-radius:6px;padding:6px 8px;resize:vertical;min-height:56px;
  }
  .meta-row{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:auto;padding-top:.4rem;}
  .via{display:inline-flex;align-items:center;gap:5px;font-family:'IBM Plex Mono', monospace;font-size:11px;color:var(--ink-soft);}
  .via::before{content:"";width:5px;height:5px;border-radius:50%;background:var(--pcb);flex:none;}
  .card-actions{display:flex;gap:4px;}
  .card-actions button{padding:5px 7px;}

  .confirm-row{display:flex;align-items:center;gap:8px;font-size:12.5px;color:var(--led);background:#FBEAE8;border:1px solid #EBC3BE;border-radius:6px;padding:6px 8px;margin-top:2px;}

  /* ---------- empty state ---------- */
  .empty{
    border:1px dashed var(--border-strong);border-radius:12px;padding:3rem 1.5rem;text-align:center;
    color:var(--ink-soft);background:rgba(255,255,255,.4);
  }
  .empty h3{font-family:'Space Grotesk', sans-serif;color:var(--ink);margin:0 0 .4rem;font-weight:600;font-size:18px;}
  .empty p{margin:0 0 1rem;font-size:14px;}

  /* ---------- modal ---------- */
  .overlay{position:fixed;inset:0;background:rgba(15,25,20,.45);display:none;align-items:center;justify-content:center;padding:1.25rem;z-index:50;}
  .overlay.open{display:flex;}
  .modal{background:var(--card);border-radius:12px;border:1px solid var(--border);max-width:440px;width:100%;padding:1.4rem;max-height:88vh;overflow:auto;}
  .modal h2{font-family:'Space Grotesk', sans-serif;font-size:19px;margin:0 0 .9rem;font-weight:600;}
  .field{margin-bottom:.9rem;}
  .field label{display:block;font-size:12.5px;font-weight:500;color:var(--ink-soft);margin-bottom:4px;}
  .field input[type="text"], .field input[type="url"], .field input[type="password"], .field textarea{
    width:100%;font-family:'IBM Plex Sans', sans-serif;font-size:14px;padding:8px 10px;
    border:1px solid var(--border-strong);border-radius:7px;background:#fff;color:var(--ink);
  }
  .field textarea{min-height:64px;resize:vertical;}
  .seg{display:flex;gap:6px;margin-bottom:.9rem;}
  .seg button{flex:1;padding:7px;border-radius:7px;border:1px solid var(--border-strong);background:#fff;font-size:13px;cursor:pointer;color:var(--ink-soft);}
  .seg button.active{background:var(--pcb);color:#fff;border-color:var(--pcb-dark);}
  .preview-box{width:100%;aspect-ratio:16/10;border:1px dashed var(--border-strong);border-radius:8px;background:#F2F4EC;display:flex;align-items:center;justify-content:center;overflow:hidden;margin-bottom:.9rem;font-size:12.5px;color:var(--ink-soft);}
  .preview-box img{width:100%;height:100%;object-fit:cover;}
  .modal-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:.5rem;}
  .err-text{color:var(--led);font-size:12.5px;margin:.2rem 0 0;}
  .hint{font-size:12px;color:var(--ink-soft);margin:.3rem 0 0;}

  .toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:var(--ink);color:#fff;font-size:13px;padding:9px 16px;border-radius:8px;z-index:60;opacity:0;pointer-events:none;transition:opacity .25s ease;}
  .toast.show{opacity:1;}

  .skeleton{background:linear-gradient(90deg,#E4E7DD 25%,#EEF1EA 37%,#E4E7DD 63%);background-size:400% 100%;animation:sk 1.4s ease infinite;border-radius:12px;height:230px;}
  @keyframes sk{0%{background-position:100% 0;}100%{background-position:0 0;}}
  @media (prefers-reduced-motion:reduce){.skeleton{animation:none;}}

  a{color:var(--pcb-dark);}
  .footer-note{margin-top:3rem;font-family:'IBM Plex Mono', monospace;font-size:11.5px;color:var(--ink-soft);text-align:center;}

  @media (max-width:480px){
    .toolbar{align-items:stretch;}
    .title-row{flex-direction:column;}
  }
</style>
</head>
<body>

<div class="wrap">

  <div class="hero">
    <svg class="trace-svg" viewBox="0 0 260 140" xmlns="http://www.w3.org/2000/svg">
      <path d="M10 120 C 60 120, 60 60, 110 60 S 160 10, 210 10 S 250 30, 250 30" fill="none" stroke="var(--copper)" stroke-width="2.5" stroke-linecap="round"/>
      <circle cx="10" cy="120" r="4" fill="var(--copper)"/>
      <circle cx="110" cy="60" r="4" fill="var(--copper)"/>
      <circle cx="210" cy="10" r="4" fill="var(--copper)"/>
      <circle cx="250" cy="30" r="4" fill="var(--copper)"/>
    </svg>
    <div class="status-bar"><span class="status-dot"></span><span id="statusText">SYSTEM: LOADING…</span></div>
    <div class="title-row">
      <div>
        <h1 id="pageTitle">Project Gallery</h1>
        <p class="subtitle" id="pageSubtitle">Loading project details…</p>
      </div>
      <div style="display:flex; gap:8px; flex-wrap:wrap;">
        <button class="btn" id="editModeBtn" type="button"></button>
      </div>
    </div>
  </div>

  <div class="toolbar">
    <span class="count-readout" id="countReadout">— photos logged</span>
    <button class="btn btn-primary" id="addPhotoBtn" type="button" style="display:none;">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
      Add photo
    </button>
  </div>

  <div id="galleryArea">
    <div class="grid">
      <div class="skeleton"></div>
      <div class="skeleton"></div>
      <div class="skeleton"></div>
    </div>
  </div>

  <p class="footer-note">Shared gallery · data is stored for everyone who opens this page</p>
</div>

<div class="overlay" id="addOverlay">
  <div class="modal">
    <h2>Add a photo</h2>
    <div class="seg">
      <button type="button" class="active" data-mode="upload" id="segUpload">Upload from device</button>
      <button type="button" data-mode="url" id="segUrl">Image URL</button>
    </div>

    <div id="uploadFields">
      <div class="field">
        <label for="fileInput">Choose an image</label>
        <input type="file" id="fileInput" accept="image/*">
      </div>
      <div class="preview-box" id="uploadPreview">Preview appears here</div>
    </div>

    <div id="urlFields" style="display:none;">
      <div class="field">
        <label for="urlInput">Image URL</label>
        <input type="url" id="urlInput" placeholder="https://example.com/photo.jpg">
      </div>
      <div class="preview-box" id="urlPreview">Preview appears here</div>
    </div>

    <div class="field">
      <label for="captionInput">Description</label>
      <textarea id="captionInput" placeholder="What's happening in this photo?"></textarea>
    </div>
    <p class="err-text" id="addError" style="display:none;"></p>
    <div class="modal-actions">
      <button class="btn" id="cancelAddBtn" type="button">Cancel</button>
      <button class="btn btn-primary" id="confirmAddBtn" type="button">Add photo</button>
    </div>
  </div>
</div>

<div class="overlay" id="passOverlay">
  <div class="modal">
    <h2 id="passTitle">Enter edit passphrase</h2>
    <p class="hint" id="passHint" style="margin-bottom:.8rem;"></p>
    <div class="field">
      <label for="passInput" id="passLabel1">Passphrase</label>
      <input type="password" id="passInput" placeholder="Enter passphrase">
    </div>
    <div class="field" id="passConfirmField" style="display:none;">
      <label for="passConfirmInput">Confirm passphrase</label>
      <input type="password" id="passConfirmInput" placeholder="Type it again">
    </div>
    <p class="err-text" id="passError" style="display:none;"></p>
    <div class="modal-actions">
      <button class="btn" id="cancelPassBtn" type="button">Cancel</button>
      <button class="btn btn-primary" id="confirmPassBtn" type="button">Continue</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
(function(){
  const INDEX_KEY = 'gallery:index';
  const SETTINGS_KEY = 'gallery:settings';
  const photoKey = id => 'gallery:photo:' + id;

  const state = {
    index: [],
    photos: {},
    settings: { title: 'Project Gallery', subtitle: 'A running log of build photos and notes.', passphraseHash: null },
    editMode: false,
    addMode: 'upload',
    pendingImage: null
  };

  const $ = sel => document.querySelector(sel);
  const galleryArea = $('#galleryArea');
  const toastEl = $('#toast');

  function showToast(msg){
    toastEl.textContent = msg;
    toastEl.classList.add('show');
    clearTimeout(showToast._t);
    showToast._t = setTimeout(() => toastEl.classList.remove('show'), 2600);
  }

  function genId(){
    return Date.now().toString(36) + Math.random().toString(36).slice(2,8);
  }

  async function sha256(text){
    const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
    return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2,'0')).join('');
  }

  async function safeGet(key, shared){
    try{
      const r = await window.storage.get(key, shared);
      return r ? r.value : null;
    }catch(e){
      return null;
    }
  }
  async function safeSet(key, value, shared){
    try{
      const r = await window.storage.set(key, value, shared);
      return !!r;
    }catch(e){
      return false;
    }
  }
  async function safeDelete(key, shared){
    try{
      await window.storage.delete(key, shared);
      return true;
    }catch(e){
      return false;
    }
  }

  function escapeText(str){
    const d = document.createElement('div');
    d.textContent = str == null ? '' : str;
    return d.innerHTML;
  }

  // ---------- Init ----------
  async function init(){
    const settingsRaw = await safeGet(SETTINGS_KEY, true);
    if (settingsRaw){
      try{ state.settings = Object.assign(state.settings, JSON.parse(settingsRaw)); }catch(e){}
    }
    renderHeader();

    const indexRaw = await safeGet(INDEX_KEY, true);
    let ids = [];
    if (indexRaw){
      try{ ids = JSON.parse(indexRaw); }catch(e){ ids = []; }
    }
    state.index = Array.isArray(ids) ? ids : [];

    const loaded = await Promise.all(state.index.map(async id => {
      const raw = await safeGet(photoKey(id), true);
      if (!raw) return null;
      try{ return JSON.parse(raw); }catch(e){ return null; }
    }));

    state.index = [];
    loaded.forEach((p, i) => {
      if (p){ state.photos[p.id] = p; state.index.push(p.id); }
    });

    $('#statusText').textContent = 'SYSTEM: GALLERY ONLINE';
    renderGrid();
    renderToolbar();
  }

  function renderHeader(){
    $('#pageTitle').textContent = state.settings.title || 'Project Gallery';
    $('#pageSubtitle').textContent = state.settings.subtitle || '';
    updateEditButton();
  }

  function updateEditButton(){
    const btn = $('#editModeBtn');
    btn.innerHTML = state.editMode
      ? '<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg> Exit edit mode'
      : '<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg> Edit mode';
  }

  function renderToolbar(){
    $('#countReadout').textContent = state.index.length + (state.index.length === 1 ? ' photo logged' : ' photos logged');
    $('#addPhotoBtn').style.display = state.editMode ? 'inline-flex' : 'none';
  }

  function renderGrid(){
    renderToolbar();
    if (state.index.length === 0){
      galleryArea.innerHTML =
        '<div class="empty">' +
          '<h3>No photos yet</h3>' +
          '<p>' + (state.editMode ? 'Add the first photo to start the build log.' : 'Turn on edit mode to add the first photo.') + '</p>' +
          (state.editMode ? '' : '') +
        '</div>';
      return;
    }
    const grid = document.createElement('div');
    grid.className = 'grid';
    state.index.forEach(id => {
      const p = state.photos[id];
      if (!p) return;
      grid.appendChild(buildCard(p));
    });
    galleryArea.innerHTML = '';
    galleryArea.appendChild(grid);
    observeCards();
  }

  function buildCard(p){
    const card = document.createElement('div');
    card.className = 'card';
    card.dataset.id = p.id;

    const frame = document.createElement('div');
    frame.className = 'img-frame';
    const img = document.createElement('img');
    img.loading = 'lazy';
    img.alt = p.caption ? p.caption.slice(0,140) : 'Project photo';
    img.src = p.imageData || p.imageUrl || '';
    img.onerror = function(){
      frame.innerHTML = '<div class="img-broken">Image unavailable<br>Link may be broken or removed</div>';
    };
    frame.appendChild(img);
    card.appendChild(frame);

    const body = document.createElement('div');
    body.className = 'card-body';

    const caption = document.createElement('p');
    caption.className = 'caption' + (p.caption ? '' : ' placeholder');
    caption.textContent = p.caption || 'No description yet.';
    body.appendChild(caption);

    const metaRow = document.createElement('div');
    metaRow.className = 'meta-row';
    const via = document.createElement('span');
    via.className = 'via';
    via.textContent = p.addedAt ? new Date(p.addedAt).toLocaleDateString(undefined,{month:'short',day:'numeric',year:'numeric'}) : '';
    metaRow.appendChild(via);

    const actions = document.createElement('div');
    actions.className = 'card-actions';
    if (state.editMode){
      actions.appendChild(makeIconBtn('edit', () => enterCaptionEdit(card, p)));
      actions.appendChild(makeIconBtn('up', () => moveCard(p.id, -1)));
      actions.appendChild(makeIconBtn('down', () => moveCard(p.id, 1)));
      actions.appendChild(makeIconBtn('trash', () => confirmDelete(card, p)));
    }
    metaRow.appendChild(actions);
    body.appendChild(metaRow);

    card.appendChild(body);
    return card;
  }

  function makeIconBtn(kind, onClick){
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = kind === 'trash' ? 'btn btn-danger' : 'btn';
    const paths = {
      edit: '<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>',
      up: '<path d="M12 19V5"/><path d="M5 12l7-7 7 7"/>',
      down: '<path d="M12 5v14"/><path d="M19 12l-7 7-7-7"/>',
      trash: '<path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>'
    };
    btn.innerHTML = '<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">' + paths[kind] + '</svg>';
    btn.setAttribute('aria-label', kind);
    btn.addEventListener('click', onClick);
    return btn;
  }

  function observeCards(){
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const cards = document.querySelectorAll('.card');
    if (reduce){ cards.forEach(c => c.classList.add('in-view')); return; }
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting){ e.target.classList.add('in-view'); io.unobserve(e.target); } });
    }, { threshold: 0.15 });
    cards.forEach(c => io.observe(c));
  }

  // ---------- Caption editing ----------
  function enterCaptionEdit(card, p){
    const body = card.querySelector('.card-body');
    const captionEl = card.querySelector('.caption');
    const existing = card.querySelector('.caption-edit');
    if (existing) return;

    const textarea = document.createElement('textarea');
    textarea.className = 'caption-edit';
    textarea.value = p.caption || '';
    captionEl.style.display = 'none';
    captionEl.insertAdjacentElement('afterend', textarea);
    textarea.focus();

    const saveRow = document.createElement('div');
    saveRow.style.display = 'flex';
    saveRow.style.gap = '6px';
    saveRow.style.marginTop = '6px';
    const saveBtn = document.createElement('button');
    saveBtn.className = 'btn btn-primary';
    saveBtn.textContent = 'Save';
    saveBtn.type = 'button';
    const cancelBtn = document.createElement('button');
    cancelBtn.className = 'btn';
    cancelBtn.textContent = 'Cancel';
    cancelBtn.type = 'button';
    saveRow.appendChild(saveBtn);
    saveRow.appendChild(cancelBtn);
    textarea.insertAdjacentElement('afterend', saveRow);

    cancelBtn.addEventListener('click', () => {
      textarea.remove();
      saveRow.remove();
      captionEl.style.display = '';
    });

    saveBtn.addEventListener('click', async () => {
      const newCaption = textarea.value.trim();
      p.caption = newCaption;
      const ok = await safeSet(photoKey(p.id), JSON.stringify(p), true);
      if (ok){
        showToast('Description saved');
        renderGrid();
      } else {
        showToast('Could not save — try again');
      }
    });
  }

  // ---------- Reorder ----------
  async function moveCard(id, dir){
    const i = state.index.indexOf(id);
    const j = i + dir;
    if (i < 0 || j < 0 || j >= state.index.length) return;
    [state.index[i], state.index[j]] = [state.index[j], state.index[i]];
    renderGrid();
    await safeSet(INDEX_KEY, JSON.stringify(state.index), true);
  }

  // ---------- Delete ----------
  function confirmDelete(card, p){
    const existing = card.querySelector('.confirm-row');
    if (existing) return;
    const row = document.createElement('div');
    row.className = 'confirm-row';
    row.innerHTML = '<span>Delete this photo?</span>';
    const yes = document.createElement('button');
    yes.className = 'btn btn-danger';
    yes.style.padding = '3px 8px';
    yes.textContent = 'Delete';
    yes.type = 'button';
    const no = document.createElement('button');
    no.className = 'btn btn-quiet';
    no.style.padding = '3px 8px';
    no.textContent = 'Cancel';
    no.type = 'button';
    row.appendChild(yes);
    row.appendChild(no);
    card.querySelector('.card-body').appendChild(row);

    no.addEventListener('click', () => row.remove());
    yes.addEventListener('click', async () => {
      state.index = state.index.filter(id => id !== p.id);
      delete state.photos[p.id];
      await safeSet(INDEX_KEY, JSON.stringify(state.index), true);
      await safeDelete(photoKey(p.id), true);
      showToast('Photo deleted');
      renderGrid();
    });
  }

  // ---------- Edit mode gating ----------
  const passOverlay = $('#passOverlay');
  function openPassModal({ creating }){
    passOverlay.classList.add('open');
    $('#passError').style.display = 'none';
    $('#passInput').value = '';
    $('#passConfirmInput').value = '';
    $('#passConfirmField').style.display = creating ? 'block' : 'none';
    $('#passTitle').textContent = creating ? 'Set an edit passphrase' : 'Enter edit passphrase';
    $('#passHint').textContent = creating
      ? 'Anyone with this passphrase will be able to edit the gallery. This is a light deterrent, not real security — treat it like a shared house key.'
      : 'Enter the passphrase to turn on edit mode.';
    $('#passInput').focus();
    passOverlay.dataset.mode = creating ? 'create' : 'check';
  }
  $('#cancelPassBtn').addEventListener('click', () => passOverlay.classList.remove('open'));

  $('#confirmPassBtn').addEventListener('click', async () => {
    const creating = passOverlay.dataset.mode === 'create';
    const val = $('#passInput').value;
    const confirmVal = $('#passConfirmInput').value;
    const errEl = $('#passError');
    if (!val){
      errEl.textContent = 'Enter a passphrase first.';
      errEl.style.display = 'block';
      return;
    }
    if (creating){
      if (val.length < 4){
        errEl.textContent = 'Use at least 4 characters.';
        errEl.style.display = 'block';
        return;
      }
      if (val !== confirmVal){
        errEl.textContent = "Passphrases don't match.";
        errEl.style.display = 'block';
        return;
      }
      const hash = await sha256(val);
      state.settings.passphraseHash = hash;
      const ok = await safeSet(SETTINGS_KEY, JSON.stringify(state.settings), true);
      if (!ok){
        errEl.textContent = 'Could not save passphrase — try again.';
        errEl.style.display = 'block';
        return;
      }
      passOverlay.classList.remove('open');
      state.editMode = true;
      updateEditButton();
      renderGrid();
      showToast('Edit mode on');
    } else {
      const hash = await sha256(val);
      if (hash !== state.settings.passphraseHash){
        errEl.textContent = 'That passphrase is incorrect.';
        errEl.style.display = 'block';
        return;
      }
      passOverlay.classList.remove('open');
      state.editMode = true;
      updateEditButton();
      renderGrid();
      showToast('Edit mode on');
    }
  });

  $('#editModeBtn').addEventListener('click', () => {
    if (state.editMode){
      state.editMode = false;
      updateEditButton();
      renderGrid();
      showToast('Edit mode off');
      return;
    }
    if (state.settings.passphraseHash){
      openPassModal({ creating:false });
    } else {
      openPassModal({ creating:true });
    }
  });

  // ---------- Editable title / subtitle ----------
  $('#pageTitle').addEventListener('dblclick', () => tryEditHeaderField('title'));
  $('#pageSubtitle').addEventListener('dblclick', () => tryEditHeaderField('subtitle'));

  function tryEditHeaderField(field){
    if (!state.editMode){ showToast('Turn on edit mode to rename this'); return; }
    const el = field === 'title' ? $('#pageTitle') : $('#pageSubtitle');
    el.contentEditable = 'true';
    el.classList.add(field === 'title' ? 'editable-title' : 'editable-sub');
    el.focus();
    const range = document.createRange();
    range.selectNodeContents(el);
    const sel = window.getSelection();
    sel.removeAllRanges();
    sel.addRange(range);

    function finish(){
      el.contentEditable = 'false';
      el.classList.remove(field === 'title' ? 'editable-title' : 'editable-sub');
      el.removeEventListener('blur', finish);
      el.removeEventListener('keydown', onKey);
      const text = el.textContent.trim();
      state.settings[field] = text || (field === 'title' ? 'Project Gallery' : '');
      el.textContent = state.settings[field];
      safeSet(SETTINGS_KEY, JSON.stringify(state.settings), true).then(ok => {
        showToast(ok ? 'Saved' : 'Could not save — try again');
      });
    }
    function onKey(e){
      if (e.key === 'Enter'){ e.preventDefault(); el.blur(); }
      if (e.key === 'Escape'){ el.textContent = state.settings[field]; el.blur(); }
    }
    el.addEventListener('blur', finish);
    el.addEventListener('keydown', onKey);
  }

  if (matchMedia('(hover:none)').matches){
    $('#pageTitle').addEventListener('click', () => { if (state.editMode) tryEditHeaderField('title'); });
    $('#pageSubtitle').addEventListener('click', () => { if (state.editMode) tryEditHeaderField('subtitle'); });
  }

  // ---------- Add photo modal ----------
  const addOverlay = $('#addOverlay');
  $('#addPhotoBtn').addEventListener('click', () => {
    state.pendingImage = null;
    $('#fileInput').value = '';
    $('#urlInput').value = '';
    $('#captionInput').value = '';
    $('#uploadPreview').innerHTML = 'Preview appears here';
    $('#urlPreview').innerHTML = 'Preview appears here';
    $('#addError').style.display = 'none';
    setAddMode('upload');
    addOverlay.classList.add('open');
  });
  $('#cancelAddBtn').addEventListener('click', () => addOverlay.classList.remove('open'));

  function setAddMode(mode){
    state.addMode = mode;
    $('#segUpload').classList.toggle('active', mode === 'upload');
    $('#segUrl').classList.toggle('active', mode === 'url');
    $('#uploadFields').style.display = mode === 'upload' ? 'block' : 'none';
    $('#urlFields').style.display = mode === 'url' ? 'block' : 'none';
  }
  $('#segUpload').addEventListener('click', () => setAddMode('upload'));
  $('#segUrl').addEventListener('click', () => setAddMode('url'));

  function compressImage(file){
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = e => {
        const img = new Image();
        img.onload = () => {
          const maxDim = 1400;
          let { width, height } = img;
          if (width > maxDim || height > maxDim){
            if (width > height){ height = Math.round(height * maxDim / width); width = maxDim; }
            else { width = Math.round(width * maxDim / height); height = maxDim; }
          }
          const canvas = document.createElement('canvas');
          canvas.width = width; canvas.height = height;
          const ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, width, height);
          let quality = 0.72;
          let dataUrl = canvas.toDataURL('image/jpeg', quality);
          while (dataUrl.length > 3500000 && quality > 0.35){
            quality -= 0.12;
            dataUrl = canvas.toDataURL('image/jpeg', quality);
          }
          resolve(dataUrl);
        };
        img.onerror = () => reject(new Error('Could not read that image file.'));
        img.src = e.target.result;
      };
      reader.onerror = () => reject(new Error('Could not read that file.'));
      reader.readAsDataURL(file);
    });
  }

  $('#fileInput').addEventListener('change', async () => {
    const file = $('#fileInput').files[0];
    const errEl = $('#addError');
    errEl.style.display = 'none';
    if (!file) return;
    if (!file.type.startsWith('image/')){
      errEl.textContent = 'Choose an image file.';
      errEl.style.display = 'block';
      return;
    }
    try{
      const dataUrl = await compressImage(file);
      state.pendingImage = { type: 'data', value: dataUrl };
      $('#uploadPreview').innerHTML = '<img src="' + dataUrl + '">';
    }catch(err){
      errEl.textContent = err.message || 'Could not process that image.';
      errEl.style.display = 'block';
    }
  });

  let urlDebounce;
  $('#urlInput').addEventListener('input', () => {
    clearTimeout(urlDebounce);
    const val = $('#urlInput').value.trim();
    urlDebounce = setTimeout(() => {
      if (!val){ $('#urlPreview').innerHTML = 'Preview appears here'; state.pendingImage = null; return; }
      $('#urlPreview').innerHTML = '<img src="' + val.replace(/"/g,'&quot;') + '" onerror="this.parentElement.textContent=\'Could not load that URL\';">';
      state.pendingImage = { type: 'url', value: val };
    }, 400);
  });

  $('#confirmAddBtn').addEventListener('click', async () => {
    const errEl = $('#addError');
    errEl.style.display = 'none';
    const caption = $('#captionInput').value.trim();

    let imageField = {};
    if (state.addMode === 'upload'){
      if (!state.pendingImage || state.pendingImage.type !== 'data'){
        errEl.textContent = 'Choose an image file first.';
        errEl.style.display = 'block';
        return;
      }
      imageField = { imageData: state.pendingImage.value };
    } else {
      const val = $('#urlInput').value.trim();
      if (!val){
        errEl.textContent = 'Enter an image URL first.';
        errEl.style.display = 'block';
        return;
      }
      imageField = { imageUrl: val };
    }

    const id = genId();
    const photo = Object.assign({ id, caption, addedAt: Date.now() }, imageField);

    const confirmBtn = $('#confirmAddBtn');
    confirmBtn.disabled = true;
    confirmBtn.textContent = 'Adding…';

    const savedPhoto = await safeSet(photoKey(id), JSON.stringify(photo), true);
    if (!savedPhoto){
      errEl.textContent = 'Could not save this photo — try again.';
      errEl.style.display = 'block';
      confirmBtn.disabled = false;
      confirmBtn.textContent = 'Add photo';
      return;
    }

    state.index.push(id);
    state.photos[id] = photo;
    const savedIndex = await safeSet(INDEX_KEY, JSON.stringify(state.index), true);
    if (!savedIndex){
      showToast('Photo saved, but the gallery order failed to update');
    }

    confirmBtn.disabled = false;
    confirmBtn.textContent = 'Add photo';
    addOverlay.classList.remove('open');
    showToast('Photo added');
    renderGrid();
  });

  init();
})();
</script>
</body>
</html>
